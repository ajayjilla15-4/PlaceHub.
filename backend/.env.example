# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB example:
# MONGODB_URI=mongodb://127.0.0.1:27017/placehub
#
# MongoDB Atlas example (replace <db_username>, <db_password>, and <cluster-address>):
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/placehub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/placehub

# JSON Web Token Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here
